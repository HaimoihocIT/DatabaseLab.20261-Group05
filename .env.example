# LOCAL ONLY. Copy to .env; never paste Cloud credentials into this file.
# npm scripts do not read this file; your future application must load it.
APP_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
# Copy the LOCAL publishable/anon key from: npx.cmd --no-install supabase status
SUPABASE_ANON_KEY=
# Backend only. Never expose this in frontend code, logs, or Git.
SUPABASE_SERVICE_ROLE_KEY=
# Fill the LOCAL PostgreSQL connection string from the private terminal when needed.
DATABASE_URL=
# If using Vite later, copy only the URL and publishable/anon key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
